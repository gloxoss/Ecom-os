{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run generate-theme && npm run generate-addons && next dev",
    "build": "npm run generate-theme && npm run generate-addons && next build --webpack",
    "build:turbopack": "npm run generate-theme && npm run generate-addons && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "generate-theme": "npx tsx scripts/generate-theme.ts",
    "generate-addons": "npx tsx ../../scripts/generate-addons.ts"
  },
  "dependencies": {
    "@ecom-os/addons-i18n": "workspace:*",
    "@ecom-os/addons-multi-payment": "workspace:*",
    "@ecom-os/brand-config": "workspace:*",
    "@ecom-os/engine": "workspace:*",
    "@ecom-os/engine-woocommerce": "workspace:*",
    "@ecom-os/themes": "workspace:*",
    "@gsap/react": "^2.1.2",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.53.0",
    "next": "16.3.8",
    "next-intl": "4.9.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
